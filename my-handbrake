do_eject() { [ $DO_EJECT ] || return; [ "$1" = "exit" ] && do_exit=1 || do_exit=; msg="$2";
  echo;
  echo "  > EJECTING '$DVD_DIR' $2...";
  eject_cmd; rc="$?"; # last trial
  if [ $rc -eq 0 ]; then
    echo "    EJECT SUCCESSFUL";
    if [ $do_exit ]; then vrb; vrb "All done - successfully"; vrb; exit 0; fi
    return 0
  else
    echo "    EJECT FAILED [$rc]: $EJECT_CMD${NL}$EJECT_CMD_OUTPUT";
    if [ $do_exit ]; then exit $rc; fi
    return 1;
  fi
}




get_scan() {
  dbg "get_scan(): \"$c_HandBrakeCLI\" -t 0 -i \"$INPUT_PATH\" 2>&1"
  "$c_HandBrakeCLI" -t 0 -i "$INPUT_PATH" 2>&1
}




# do_echo controls if resulting lines will be printed or not
# in any case the 2 GLOBAL VARIABLES:   TITLES_LIST
#                                       TITLES_LIST_CNT    will be set!
# Used in both DVD and FILE mode !
# In FILE mode this uses simply $OUTPUT_PATH to set '\$output' in the ENCODE STRING
#
# Uses $DO_GAP_ANALYSIS to decide if it will check for a gap of 1 title and identical titles BEFORE and AFTER the gap
# as this seems a common pattern in DVDs from TV recorders!
#
get_titles() { local do_not_echo_filtered_titles="$1"; local do_not_echo_ALL_titles="$2";
  local output_fn=;
  local raw="$( get_scan )"
  dbg "DBG get_titles: raw:" "$raw" "DBG: ^^^^^^^^^^^^^^^^^^^^^";
  local raw_titles="$( echo "$raw"|env LC_ALL=C gawk -b '/^[+] title [1-9][0-9]*/{flag=1;print $0; next}/^HandBrake has exited.$/{flag=0}flag' )"
  dbg "DBG get_titles: raw_titles:" "$raw_titles" "DBG: ^^^^^^^^^^^^^^^^^^^^^";
  local titles="$(echo "$raw_titles"|sed -n 's/[+] title \([1-9][0-9]*\):.*/\1/p'|sort -n|xargs echo)" #sed cannot issue 00 !?! |env LC_ALL=C gawk -b '{if (!/00/)print $0}')"
  dbg "DBG get_titles: Found titles: '$titles'";
  [ -z "$titles" ] && err 011 "Problem extracting titles. Check with 'scan'."

  local use=;
  local input_nr=; case "$MODE" in DVD) input_nr="$DVD_NR"; TITLES_LIST_HEADER="DVD_NR";; FILE) input_nr="$FILE_NR"; TITLES_LIST_HEADER="FILE_NR";; esac
  ALL_TITLES_LIST_HEADER="$TITLES_LIST_HEADER$( printf "\ttitleNr\tdur.\taudio\tsub\n" )"
  TITLES_LIST_HEADER="$TITLES_LIST_HEADER$( printf "\ttitlCnt\ttitleNr\tdurat.\taudio\tsub\toutput_fn\n" )"
  [ -z "$input_nr" ] && err 081 "MODE='$MODE', DVD_NR='$DVD_NR', FILE_NR='$FILE_NR'"

  [ "$MODE" = "FILE" ] && do_not_echo_ALL_titles="1";

  if [ -z "$do_not_echo_ALL_titles" ]; then
    # count *ALL* (available) titles:
    local all_titles_cnt=0; for title_nr in $titles; do all_titles_cnt=$(( $all_titles_cnt + 1 )); done
    [ $all_titles_cnt -eq 0 ] && err 055 "NO TITLES found ?! Please check";
    echo ">>> ALL $all_titles_cnt TITLES: $titles of '$DVD_DIR'${NL}$ALL_TITLES_LIST_HEADER";
  fi

  TITLES_LIST=;          # GLOBAL-VARIABLE! -- like ECHO_TITLES_LIST, but FILENAME is on separate line (instead in last column)
  TITLES_LIST_CNT=0;     # GLOBAL-VARIABLE! -- counts only *use*d titles !!
  SELECTED_TITLE_NRS=""; # GLOBAL-VARIABLE!
  ECHO_TITLES_LIST="";   # GLOBAL-VARIABLE -- like TITLES_LIST, but all in 1 LINE !

  local all_titles_str=""
  local dbgPfx="DBG get_titles: input_nr:'$input_nr' (${MODE}_NR) "
  local gap_cnt=0; local gap_at_title_nr=; local last_title_nr=0;
                   local title_list_after_gap=;  local title_list_after_gap_cnt=0;  local title_nrs_after_gap=;  local echo_title_list_before_gap=;
                   local title_list_before_gap=; local title_list_before_gap_cnt=0; local title_nrs_before_gap=; local echo_title_list_after_gap=;
  local TITLE_COUNT=0; local title_count_before_gap=;

  for TITLE_NR in $titles; do
     TITLE_COUNT=$(( $TITLE_COUNT + 1 ));
     # extract variables for this TITLE with $TITLE_NR:
     this_title="$(echo "$raw_titles"|sed -n "/^+ title $TITLE_NR:/,/^+ title [0-9][0-9]*/p")"
     dbg; dbg "${dbgPfx}TITLE_NR:'$TITLE_NR' (potential TITLE_COUNT=$TITLE_COUNT (if we keep this title)) --> this_title='''$this_title'''"
     [ -z "$this_title" ] && err 075

     if [ $DO_GAP_ANALYSIS -eq 1 ]; then
       tmp_nr="$(( $last_title_nr + 1 ))" || err 076
       dbg "${dbgPfx}DO_GAP_ANALYSIS: gap_cnt='$gap_cnt' :: last_title_nr='$last_title_nr', TITLE_NR='$TITLE_NR' -> tmp_nr='$tmp_nr'"
       if [ $tmp_nr -eq $TITLE_NR ]; then
         dbg "${dbgPfx}DO_GAP_ANALYSIS: TITLE_NR='$TITLE_NR': NO GAP detected (last_title_nr='$last_title_nr')"
       else # GAP DETECTED !
         gap_cnt="$(( $gap_cnt + 1 ))";
         dbg "${dbgPfx}DO_GAP_ANALYSIS: TITLE_NR='$TITLE_NR': GAP #$gap_cnt detected at TITLE Nr '$tmp_nr' (last_title_nr='$last_title_nr')"
         gap_at_title_nr=$tmp_nr;
         title_list_before_gap="$TITLES_LIST"; title_list_before_gap_cnt="$TITLES_LIST_CNT"
         title_count_before_gap="$(( $TITLE_COUNT - 1 ))"
         title_nrs_before_gap="$SELECTED_TITLE_NRS"
         echo_title_list_before_gap="$ECHO_TITLES_LIST"
       fi
     fi

     TITLE_NR_2DIGIT="$(format_as_2_digits "$TITLE_NR")"
     TITLE_COUNT_2DIGIT="$(format_as_2_digits "$TITLE_COUNT")"
     duration="$(echo "$this_title"|sed -n 's/.* + duration: \([0-9][0-9]:[0-9][0-9]\):[0-9][0-9]$/\1/p')"
     audio="$(echo "$this_title"|sed -n '/^  + audio tracks:/,/^\(  \)\?+ /p'|sed -n 's/^    + \([1-9][0-9]*\).*/\1/p'|xargs echo|env LC_ALL=C gawk -b '{gsub(" ",","); print $0}' )"
     sub="$(echo "$this_title"|sed -n '/^  + subtitle tracks:/,/^\(  \)\?+ /p'|sed -n 's/^    + \([1-9][0-9]*\).*/\1/p'|xargs echo|env LC_ALL=C gawk -b '{gsub(" ",","); print $0}' )"
     use=""; case "$MODE" in FILE) use=1;; DVD) DVD_decideIfTitleIsSelected && use=1;; esac
     [ -z "$sub" ] && { sub=_; dbg "WARNING: title $TITLE_NR: No subtitles found!"; }
     #There CAN be no-audio [ -z "$audio" ] && err 025 "Missing value for 'audio'. No sound ??"
     [ -z "$duration" ] && err 026 "Missing value for 'duration'. No duration ??"

     dbg "${dbgPfx}TITLE_NR:'$TITLE_NR' duration:'$duration' audio:'$audio' subtitles:'$sub' -- use='$use'";

     # first ensure to print title - if we should echo_ALL_titles:
     [ -z "$do_not_echo_ALL_titles" ] && printf "$input_nr\t$TITLE_NR\t$duration\t$audio\t$sub\n"

     # continue if we should /use/ this TITLE:
     [ -z "$use" ] && last_title_nr="$TITLE_NR" && TITLE_COUNT=$(( $TITLE_COUNT - 1 )) && continue;

     # set output_fn + MODE specifics (e.g. set/overwrite some values)
     case "$MODE" in
       FILE)
         output_fn="$OUTPUT_PATH";

         # overwrite audio ?
         [ -n "$FILE_AUDIO" ] && { audio="$FILE_AUDIO"; dbg "DBG get_titles: Using \$FILE_AUDIO '$FILE_AUDIO'."; }

         # overwrite sub ?
         [ -n "$FILE_SUB" ] && { sub="$FILE_SUB"; dbg "DBG get_titles: Using \$FILE_SUB '$FILE_SUB'."; }

         ;;
       DVD)
         # overwrite audio ?
         [ -n "$DVD_AUDIO" ] && { audio="$DVD_AUDIO"; dbg "DBG get_titles: Using \$DVD_AUDIO '$DVD_AUDIO'."; }

         # overwrite sub ?
         [ -n "$DVD_SUB" ] && { sub="$DVD_SUB"; dbg "DBG get_titles: Using \$DVD_SUB '$DVD_SUB'."; }

         # set DVD_EPISODE_STR:
         if [ -z "$DVD_EPISODE" ]; then
           DVD_EPISODE_STR="TITLE_#${TITLE_NR}"; [ -n "$DVD_NR_2" ] && DVD_EPISODE_STR="DVD_#${DVD_NR_2}_${DVD_EPISODE_STR}"
         else
           case $all_titles_cnt in 1) DVD_EPISODE_STR="" ;;
                                   *) DVD_EPISODE_STR="S$(format_as_2_digits "$DVD_SEASON")E$(format_as_2_digits "$DVD_EPISODE")"
                                      DVD_EPISODE=$(( $DVD_EPISODE + 1 ));
                                      dbg "DBG get_titles: DVD_EPISODE_STR='$DVD_EPISODE_STR' && increased DVD_EPISODE to '$DVD_EPISODE'" ;;
           esac;
         fi;

         # prepare '$CTP' with TITLE SPECIFIC string for this TITLE_NR ! (see --ctp<TITLE_NR>)
         eval "CTP=\"\$CTP$TITLE_NR\"" && dbg "DBG get_titles: Using \$CTP '$CTP' (from CTP$TITLE_NR).";

         # set output_fn:
         dbg "DBG get_titles: eval \"output_fn='$DVD_OUTPUT_FN'\""
         eval "output_fn=\"$DVD_OUTPUT_FN\"";
         if [ $DO_GAP_ANALYSIS -eq 1  -a  $gap_cnt -eq 1 ]; then # VIDEO DVDs from Panasonic TV DVD Recorder show each title 2x with gap of 1 title !
           corresponding_title_nr_before_gap="$(( $TITLE_NR - $gap_at_title_nr ))" || err 077
           corresponding_title_count_before_gap="$(( $TITLE_COUNT - $title_count_before_gap ))" || err 078
           dbg "${dbgPfx}DO_GAP_ANALYSIS: TITLE_NR='$TITLE_NR', gap_at_title_nr='$gap_at_title_nr' -> corresponding_title_nr_before_gap='$corresponding_title_nr_before_gap', corresponding_title_count_before_gap='$corresponding_title_count_before_gap'"
           tmp_nr=$TITLE_NR; tmp_count=$TITLE_COUNT; tmp_nr_2digit=$TITLE_NR_2DIGIT; tmp_count_2digit=$TITLE_COUNT_2DIGIT; # <<< BACKUP
           TITLE_NR="$corresponding_title_nr_before_gap";       TITLE_NR_2DIGIT="$(format_as_2_digits "$TITLE_NR")"
           TITLE_COUNT="$corresponding_title_count_before_gap"; TITLE_COUNT_2DIGIT="$(format_as_2_digits "$TITLE_COUNT")"
           eval "corresponding_output_fn=\"$DVD_OUTPUT_FN\"";
           TITLE_NR=$tmp_nr; TITLE_COUNT=$tmp_count; TITLE_NR_2DIGIT=$tmp_nr_2digit; TITLE_COUNT_2DIGIT=$tmp_count_2digit; # <<< RESTORE
         fi
         ;;
     esac

     dbg "${dbgPfx}TITLE_NR:'$TITLE_NR' duration:'$duration' audio:'$audio' subtitles:'$sub' output_fn='$output_fn' -- use='$use'";

     dbg "${dbgPfx}\"input_nr\" \"TITLE_COUNT\" \"TITLE_NR\" \"duration\" \"audio\" \"sub\"" # audio_tracks sub_tracks
     dbg "${dbgPfx}\"output_fn\""
     res="$(printf "$input_nr\t$TITLE_COUNT\t$TITLE_NR\t$duration\t$audio\t$sub\n$output_fn\n")";
     [ -z "$TITLES_LIST" ] && TITLES_LIST="$res" || TITLES_LIST="$TITLES_LIST${NL}$res"
     echo_res="$(printf "$input_nr\t$TITLE_COUNT\t$TITLE_NR\t$duration\t$audio\t$sub\t$output_fn\n")";
     [ -z "$ECHO_TITLES_LIST" ] && ECHO_TITLES_LIST="$echo_res" || ECHO_TITLES_LIST="$ECHO_TITLES_LIST${NL}$echo_res"
     TITLES_LIST_CNT=$(( $TITLES_LIST_CNT + 1 ));
     [ -z "$SELECTED_TITLE_NRS" ] && SELECTED_TITLE_NRS="$TITLE_NR" || SELECTED_TITLE_NRS="$SELECTED_TITLE_NRS $TITLE_NR"

     if [ $DO_GAP_ANALYSIS -eq 1  -a  $gap_cnt -eq 1 ]; then # VIDEO DVDs from Panasonic TV DVD Recorder show each title 2x with gap of 1 title !
       dbg "${dbgPfx}DO_GAP_ANALYSIS: GAP_CNT == 1 --> collecting titles AFTER GAP"
       res="$(printf "$input_nr\t$corresponding_title_count_before_gap\t$corresponding_title_nr_before_gap\t$duration\t$audio\t$sub\n$corresponding_output_fn\n")";
       echo_res="$(printf "$input_nr\t$corresponding_title_count_before_gap\t$corresponding_title_nr_before_gap\t$duration\t$audio\t$sub\t$corresponding_output_fn\n")";
       [ -z "$title_list_after_gap" ] && title_list_after_gap="$res" || title_list_after_gap="$title_list_after_gap${NL}$res"
       [ -z "$echo_title_list_after_gap" ] && echo_title_list_after_gap="$echo_res" || echo_title_list_after_gap="$echo_title_list_after_gap${NL}$echo_res"
       title_list_after_gap_cnt=$(( $title_list_after_gap_cnt + 1 ));
       [ -z "$title_nrs_after_gap" ] && title_nrs_after_gap="$TITLE_NR" || title_nrs_after_gap="$title_nrs_after_gap $TITLE_NR"
     fi;
     last_title_nr="$TITLE_NR"
  done
  dbg "${dbgPfx}AFTER LOOP OVER ALL TITLES: TITLES_LIST_CNT='$TITLES_LIST_CNT', SELECTED_TITLE_NRS='$SELECTED_TITLE_NRS'"

  if [ $TITLES_LIST_CNT -eq 0 ]; then
    vrb;
    echo "WARNING: No titles found. Please check your TITLES selection parameters (e.g. --titles, --all, --mindur, --maxdur)" 1>&2
    return 0;
  fi

  if [ $DO_GAP_ANALYSIS -eq 1 ]; then
    dbg "${dbgPfx}DO_GAP_ANALYSIS: RESULT: gap_cnt='$gap_cnt', gap_at_title_nr='$gap_at_title_nr', title_list_before_gap_cnt='$title_list_before_gap_cnt', title_list_after_gap_cnt='$title_list_after_gap_cnt'"
    dbg "${dbgPfx}DO_GAP_ANALYSIS: RESULT: title_list_before_gap:${NL}$title_list_before_gap${NL}^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^"
    dbg "${dbgPfx}DO_GAP_ANALYSIS: RESULT: title_list_after_gap:${NL}$title_list_after_gap${NL}^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^"

    if [ $gap_cnt -eq 1 ]; then
      dbg "${dbgPfx}DO_GAP_ANALYSIS: GAP_CNT == 1 --> checking for symmetric titles BEFORE + AFTER gap:"
      if [ "$title_list_before_gap_cnt" = "$title_list_after_gap_cnt"  -a  "$title_list_before_gap" = "$title_list_after_gap" ]; then
        [ $all_titles_cnt -ge $gap_at_title_nr ] || err 074 "all_titles_cnt='$all_titles_cnt' should be EQUAL or LARGER than gap_at_title_nr='$gap_at_title_nr', ";
        vrb ">>> DO_GAP_ANALYSIS --> WARNING :: IGNORING $title_list_after_gap_cnt TITLES '$title_nrs_after_gap'  AFTER GAP at title nr '$gap_at_title_nr'! (only keeping titles $title_nrs_before_gap)"
        TITLES_LIST="$title_list_before_gap";
        TITLES_LIST_CNT="$title_list_before_gap_cnt";
        SELECTED_TITLE_NRS="$title_nrs_before_gap"
        ECHO_TITLES_LIST="$echo_title_list_before_gap"
      else
        # TITLES_LIST can stay as it is!
        dbg "${dbgPfx}DO_GAP_ANALYSIS: GAP_CNT == 1, but title_list_before_gap does NOT match title_list_after_gap! -> NOT reducing TITLES SELECTION because of GAP!"
      fi
    fi
  fi;

  [ -z "$do_not_echo_filtered_titles" ] && echo ">>> $TITLES_LIST_CNT $( [ "$MODE" = "DVD" ] && echo "FILTERED TITLE(S): $SELECTED_TITLE_NRS of '$DVD_DIR'" || echo "FILE(s)" ):${NL}$TITLES_LIST_HEADER${NL}$ECHO_TITLES_LIST";
  [ $DBG ] && echo "${NL}^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^";
  [ 1 -eq 1 ]
}


# context = "title #21 (4/5)"
#
encode() { local context="$1"; local cmdstr_name="$2";
           local input="$3"; local output="$4"; local title="$5"; local subtitles="$6"; local audio="$7";  local quality="$8"; # <<< these variable names are needed for eval and represent the possible variable names in cmdstr_4_eval !
  NOW="$(date +"%Y-%m-%d %H-%M-%S")";
  # if only FILEname-part-of-$output == $output --> we have NO path as part of $output:
  [ "${output##*/}" = "$output" ] && local logfile="$PWD/$output $NOW.log" || local logfile="$output $NOW.log" 
  unset subtitles;
  local cmdstr_verb="$( cat - <<__HIHAH__
$( eval "echo \"\$$cmdstr_name\"" )
__HIHAH__
)"
  #local cmdstr_4_eval="unbuffer $( cat - <<__HIHAH__
  local cmdstr_4_eval="stdbuf -i0 -o0 -e0 $( cat - <<__HIHAH__
$( eval "echo \"\$$cmdstr_name\""|env LC_ALL=C gawk -b '{if (!/^[[:space:]]*#/ && !/^[[:space:]]*$/){sub(/###.*$/,"");print $0}}'|xargs echo )
__HIHAH__
)"

  ### PARAMETER TUNING:
  [ "$MODE" = "FILE" -o -z "$title" ]       && cmdstr_4_eval="$(echo "$cmdstr_4_eval"|sed -e 's/ --title / /')";     # REMOVE PARAM --title (in FILE mode or without $title)
  [ "$MODE" != "DVD" ]                      && cmdstr_4_eval="$(echo "$cmdstr_4_eval"|sed -e 's/ --no-dvdnav / /')"; # REMOVE PARAM --no-dvdnav (NOT DVD mode)

  [ "$audio" = "_" -o -z "$audio" ]         && cmdstr_4_eval="$(echo "$cmdstr_4_eval"|sed -e 's/ --audio "$audio"/ --all-audio/')"; # ALL audio tracks!
  [ "$subtitles" = "_" -o -z "$subtitles" ] && cmdstr_4_eval="$(echo "$cmdstr_4_eval"|sed -e 's/ --subtitle "$subtitles"/ --all-subtitles/')"; # ALL subs

  dbg "DBG encode: $context -- CMDSTR_verb=${NL}$cmdstr_verb<<<<<<<<<<<<<<<${NL}^^^^^^^^^^^^^^^^^^^^^^^^^^^";
  dbg "DBG encode: $context"
  [ $DBG ] && printf "DBG: cmdstr_4_eval='%s'\n" "$cmdstr_4_eval";

  output_orig="$output"
  output="$output_orig.UNFINISHED"

  if [ $DBG ]; then
    local used_variables="$( echo "$cmdstr_4_eval"| sed -u -n 's/[^$]*$\([a-zA-Z_][a-zA-Z_0-9]*\)[^$]*/\1 /pg'| xargs echo )"
    dbg "DBG encode $context: Extracting all used_variables='$used_variables'"
    dbg ">>> encode: eval \"$cmdstr_4_eval\"";
    [ -n "$used_variables" ] && { dbg "            VARIABLES:"; for v in $used_variables; do dbg "                $v = \"$(eval "echo \"\$$v\"")\""; done; }
  fi;

  if [ $DRY_RUN ]; then
    echo "  > Would run: \"$( eval "echo \"$cmdstr_4_eval\"" )\" && mv \"$output\" \"$output_orig\""
  else
    [ -z "$TEMPFILES" ] && TEMPFILES="$output" || TEMPFILES="$TEMPFILES${NL}$output"

    #if [ $VRB ]; then # ALWAYS PRINT the CMD:
      [ -z "$DO_CLEANUP" ] && tmp=" (leaves '$output' behind, if it fails)" || tmp=;
      tmp="$(echo "$cmdstr_4_eval"|sed -u -e 's/"/\\"/g')" # quote the parameters!
      dbg "DBG encode cmdstr_4_eval='${tmp}'";
      if [ -z "$DBG" ]; then
        now="$(date +"%Y-%m-%d_%H%M.%S")";
        if [ -z "$VRB" ]; then
          eval "echo \"  > $now | encode via: $tmp\"" | tee "$logfile" || err 056 "FAILED to create logfile '$logfile'. Please check."
          echo "  > $now | less +F '$logfile'";
        else # DBG="", VRB=1
          eval "echo \"  > $now | encode via: $tmp\"" | tee "$logfile" || err 056 "FAILED to create logfile '$logfile'. Please check."
          echo "    To see progress:${NL}    less +F '$logfile'";
        fi
      else
        eval "echo \"  > $(date +"%Y-%m-%d_%H%M.%S") | encode via: $tmp\""
      fi
    #fi;

    rc_file="/tmp/my-handbrake.$$.handbrakeCLI-call.rc"
    echo "0" > "$rc_file" || err 061 # by default return code is 0

    if [ $DBG ]; then
      eval "$cmdstr_4_eval 2>&1 || echo \"\$?\" > \"$rc_file\""|env LC_ALL=C gawk -b '{gsub(/[\r]/,"\n");print $0;fflush()}'| tee -a "$logfile";
    else
      eval "$cmdstr_4_eval 2>&1 || echo \"\$?\" > \"$rc_file\""|env LC_ALL=C gawk -b '{gsub(/[\r]/,"\n"); if ($0 ~ /libdvdread: CHECK_VALUE failed in /) next; print $0;fflush()}' >> "$logfile";
    fi;

    [ -s "$rc_file" ] || err 062 "rc_file='$rc_file'"
    rc=$(( $(cat "$rc_file") )) || err 063 "rc_file='$rc_file'"
    echo "RC='$rc'" >>"$logfile" || err 066
    [ -n "$rc" ] || err 064 "rc_file='$rc_file'"
    /bin/rm "$rc_file" || err 065 "rc_file='$rc_file'"
    [ -z "$DO_CLEANUP" ] && tmp=" - leaving output '$output' behind" || tmp=" - output '$output_orig'";
    if [ "$rc" != "0" ]; then err 001 "$(date +"%Y-%m-%d_%H%M.%S") FAILED [$rc] to encode $context$tmp!"; fi
    tmpstr="  > $(date +"%Y-%m-%d_%H%M.%S") | Successfully done with encode $context!"
    echo "$tmpstr" >> "$logfile"
    TEMPFILES="$TEMPFILES${NL}$logfile" # only do this here to KEEP logfile in case of FAILURE :)

    mv "$output" "$output_orig" || err 010 "Failed to move '$output' -> '$output_orig'. Not sure why :/"
    TEMPFILES="$(echo "$TEMPFILES"|env LC_ALL=C gawk -b -v "x=$output" '{if ($0 !=x)print $0}')"
    cp "$logfile" "$LAST_LOGFILE" || err 032
    dbg "DBG encode $context: Done (successfully) with encode! TEMPFILES='$TEMPFILES'"
    echo "$tmpstr Logfile:    less '$LAST_LOGFILE'"
    dbg "DBG sleeping 3 to increase probability that eject works (??)"
    sleep 3;
  fi
}



get_encode() {

  NOW="$(date +"%Y-%m-%d %H-%M-%S")";
  local tmpFile="/tmp/my-handbrake_${NOW}_$$___encode____titles.log"

  [ -z "$TEMPFILES" ] && TEMPFILES="$tmpFile" || TEMPFILES="$TEMPFILES${NL}$tmpFile"

  #get_titles "do_not_echo_filtered_titles" || err 021 "Failed to call get_titles."
  get_titles || err 057 "Failed to call get_titles."
  echo "$TITLES_LIST" >"$tmpFile"   || err 022 "Failed to create tempfile '$tmpFile'."
  [ "$(cat "$tmpFile")" = "$TITLES_LIST" ] || err 023 "Missmatch found between content of tempfile '$tmpFile':
@@@$(cat "$tmpFile")@@@
and the TITLES_LIST variable:
@@@$TITLES_LIST@@@"

  dbg "=================================================================================";
  dbg "DBG get_encode: TEMPFILES=@@@$TEMPFILES@@@ TITLES_LIST_CNT='$TITLES_LIST_CNT' TITLES_LIST=
$(cat "$tmpFile")
^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^"

  # parameter for encode():
  local context=; local cmdstr_name=; local input=; local output=;
  local input_nr=; local title_nr=; local duration=; local audio=; local subtitles=; local output_fn=;
  local input_nr_2="$(format_as_2_digits $input_nr)";
  local i=0;
  while read input_nr title_count title_nr duration audio subtitles <&3; do
    read output_fn <&3 || err 034
    i=$(( $i + 1 ));
    dbg; dbg "___________________________________________________________________________________________________________________________________________";
    dbg "DBG get_encode: [LOOP i=$i] input_nr='$input_nr'(${MODE}_NR) title_count='$title_count' title_nr='$title_nr' duration='$duration' audio='$audio' subtitles='$subtitles' output_fn='$output_fn'";

    [ "$subtitles" = "_" ] && subtitles=;

    input_nr_2=$(format_as_2_digits "$input_nr");

    #OLD: context="DVD $INPUT_IDX/$TOTAL_INPUT_CNT (#${input_nr_2}) - title $i/$TITLES_LIST_CNT (#${title_nr})"
    #OLD: context="FILE $FILE_NR/$TOTAL_INPUT_CNT ($input_fn -> $output_fn)"
    context="${MODE} $INPUT_IDX/$TOTAL_INPUT_CNT (#${input_nr_2}) - title $i/$TITLES_LIST_CNT (#${title_nr})"
    cmdstr_name="MY_PRESET_${ENCODE_CMDSTR_NAME}"
    input="$INPUT_PATH"    # globally set
    output="$output_fn" # from get_titles
    quality="$ENCODE_QUALITY"

    echo ">>> $context $duration..."; dbg
    [ "$MODE" = "FILE" ] && echo "   '$INPUT_PATH'"
    if [ -n "$ENCODE_ONLY" ]; then
      if echo "$output_fn"|grep -iq "$ENCODE_ONLY"; then
          [ $VRB ] && vrb "  > Encoding because output_fn '$output_fn' *IS* matching ENCODE_ONLY grep pattern '$ENCODE_ONLY' (provided by --only)!"
      else
          [ $VRB ] && vrb "  > Skipping output_fn '$output_fn' *NOT* matching ENCODE_ONLY grep pattern '$ENCODE_ONLY' (provided by --only)!" || echo "  > Skipping..."
          continue;
      fi
    fi
    if [ -e "$output" ]; then # this is a feature, not a bug (to NOT use [ -s ... ] because we might touch encoded files to keep a record after we moved them on to bigger storage
      if [ -z "$ENCODE_FORCE_OVERWRITE_EXISTING" ]; then # skip if $output exists!
        echo "  > Skipping already existing '$output'!"
        continue;
      else
        echo "  > You provided --force-overwrite --> REMOVING OLD file '$output'";
        rm "$output" || err 019 "Failed to remove existing output file '$output'. We tried to remove, as --force-overwrite was set."
      fi;
    fi;
    dbg "DBG get_encode: [LOOP i=$i] encode context='$context' cmdstr_name='$cmdstr_name' input='$input' output='$output' title='$title_nr' subtitles='$subtitles' audio='$audio' quality='$quality'"
    #[ -z "$DO_CLEANUP" ] && tmp=" -- leaves '$output'.UNFINISHED behind, if it fails!" || tmp=;
    #echo "encode \"$context\" \"$cmdstr_name\" \"$input\" \"$output\" \"$title_nr\" \"$subtitles\" \"$audio\" \"$quality\"$tmp"
    encode "$context" "$cmdstr_name" "$input" "$output" "$title_nr" "$subtitles" "$audio" "$quality"
    rc=$?
    dbg "DBG get_encode: [LOOP i=$i] encode context='$context': DONE [RC=$rc] - TEMPFILES='$TEMPFILES'".
  done 3<"$tmpFile"
  # </dev/null, because: HandBrakeCLI reads stdin (probably to check if interactive shell, because with </dev/null, the progress output disappears)
  # SEE: http://mywiki.wooledge.org/BashFAQ/089

  rm -f "$tmpFile" || err 024 "Failed removing tempfile '$tmpFile'."
  TEMPFILES="$(echo "$TEMPFILES"|env LC_ALL=C gawk -b -v "x=$tmpFile" '{if ($0!=x)print $0}')"

  dbg "DBG get_encode: DONE (with LOOP) [RC=$rc] - TEMPFILES='$TEMPFILES'"
  return $rc
}


# returns 0 if we USE the title $TITLE_NR --> DVD_decideIfTitleIsSelected && use=1
DVD_decideIfTitleIsSelected() {
  dbg "DBG DVD_decideIfTitleIsSelected(): TITLE_NR='$TITLE_NR', duration='$duration' -- Using DVD_ALL_TITLES='$DVD_ALL_TITLES' DVD_MAIN_TITLE='$DVD_MAIN_TITLE' DVD_TITLE_MINDUR='$DVD_TITLE_MINDUR' DVD_TITLE_MAXDUR='$DVD_TITLE_MAXDUR' DVD_TITLES='$DVD_TITLES' DVD_TITLES_INCLUDE='$DVD_TITLES_INCLUDE' DVD_TITLES_EXCLUDE='$DVD_TITLES_EXCLUDE'";

  use=;
  if [ -n "$DVD_TITLES" ]; then
    for b in $DVD_TITLES; do [ "$b" = "$TITLE_NR" ] && use=1 && break; done
    dbg "DBG DVD_decideIfTitleIsSelected(): TITLE_NR='$TITLE_NR' -- use='$use' after loop over '$DVD_TITLES'"
    [ $use ] && return 0;
  fi;

  if [ $DVD_MAIN_TITLE ]; then
    echo "$this_title"|env LC_ALL=C gawk -b -v "w=  + Main Feature" '$0==w{found=1;exit;}END{if (found==1){exit 0}else{exit 1}}' && use=1;
    dbg "DBG DVD_decideIfTitleIsSelected(): TITLE_NR='$TITLE_NR' -- DVD_MAIN_TITLE --> use='$use'"
    if [ $use ]; then
      vrb "  > CONSIDERING DVD#$DVD_NR:title#$TITLE_NR (through parameter --main)";
    fi
  fi

  if [ -n "$DVD_TITLES_INCLUDE" ]; then
    echo " $DVD_TITLES_INCLUDE "|env LC_ALL=C gawk -b -v "w= $DVD_NR:$TITLE_NR " '$0==w{found=1;exit;}END{if (found==1){exit 0}else{exit 1}}' \
      && { use=1; vrb "  > CONSIDERING DVD#$DVD_NR:title#$TITLE_NR (through parameter --exclude)"; }
  fi

  [ $DVD_ALL_TITLES ] && use=1;

  # titles can be ONLY selected by DURATION /or/ can be EXCLUDED because of DURATION
  if [ -z "$use" -o -n "$DVD_ALL_TITLES" ]; then
    if [ -n "$DVD_TITLE_MINDUR" ]; then
      if [ -n "$DVD_TITLE_MAXDUR" ]; then [ "$duration" \> "$DVD_TITLE_MINDUR" ] && [ "$duration" \< "$DVD_TITLE_MAXDUR" ] && use=1 || use="";
      else [ "$duration" \> "$DVD_TITLE_MINDUR" ] && use=1 || use=""; fi;
    else
      if [ -n "$DVD_TITLE_MAXDUR" ]; then [ "$duration" \< "$DVD_TITLE_MAXDUR" ] && use=1 || use=""; fi;
    fi
  fi

  if [ -n "$use" -a -n "$DVD_TITLES_EXCLUDE" ]; then
    echo " $DVD_TITLES_EXCLUDE "|env LC_ALL=C gawk -b -v "w= $DVD_NR:$TITLE_NR " '$0==w{found=1;exit;}END{if (found==1){exit 0}else{exit 1}}' \
      && { use=; vrb "  > EXCLUDED DVD#$DVD_NR:title#$TITLE_NR (through parameter --exclude)"; }
  fi;

  dbg "DBG DVD_decideIfTitleIsSelected(): --> use='$use'"
  [ "$use" = 1 ] && return 0 || return 1;
}


