ENCODE_LIST=; ENCODE_LIST_CNT=0; # make sure that these variables are GLOBAL

[ -z "$ENCODE_QUALITY" ] && { ENCODE_QUALITY="$MY_DEFAULT_QUALITY"; dbg "DBG: Setting ENCODE_QUALITY using \$MY_DEFAULT_QUALITY '$MY_DEFAULT_QUALITY' from CONF_FILE."; }
[ -z "$ENCODE_CMDSTR_NAME" ] && { ENCODE_CMDSTR_NAME="$MY_DEFAULT_PRESET"; dbg "DBG: Setting ENCODE_CMDSTR_NAME using \$MY_DEFAULT_PRESET '$MY_DEFAULT_PRESET' from CONF_FILE."; }
[ -z "$ENCODE_CMDSTR_NAME" ] && err 014 "Missing ENCODE_CMDSTR_NAME. Check if you have a variable MY_DEFAULT_PRESET in CONF_FILE '$CONF_FILE'.";

case "$MODE" in
  DVD)
    get_output_suffix "$ENCODE_CMDSTR_NAME"; dbg "DBG: Set OUTPUT_SUFFIX='$OUTPUT_SUFFIX'"
    if [ -z "$DVD_OUTPUT_FN" ]; then
      DVD_OUTPUT_FN="$( echo "/${DVD_DIR}/"|sed -n 's|.*/\([^/]*\)/\+$|\1|p' )_\${DVD_EPISODE_STR}${DVD_OUTPUT_FN_TAG}.$OUTPUT_SUFFIX";
      dbg "DBG: Setting DVD_OUTPUT_FN using DVD_DIR '$DVD_DIR': '$DVD_OUTPUT_FN'";
    else
      # if DVD_OUTPUT_FN does NOT end yet with OUTPUT_SUFFIX: add it:
      DVD_OUTPUT_FN="$( echo "$DVD_OUTPUT_FN"|env LC_ALL=C gawk -v SFX="$OUTPUT_SUFFIX" -b '{if (match($0,"[.]"SFX"$")){print $0}else{print $0"."SFX}}' )"
      dbg "DBG: Setting DVD_OUTPUT_FN using OUTPUT_SUFFIX '$OUTPUT_SUFFIX': '$DVD_OUTPUT_FN'";
    fi
    [ -z "$DVD_OUTPUT_FN" ] && err 016 "Missing DVD_OUTPUT_FN. Not sure why... Check: echo \"/${DVD_DIR}/\"|sed -n 's|.*/\\([^/]*\\)/\\+$|\\1|p'";

    [ -d "$OUTPUT_DIR___DVD" ] || err 017 "OUTPUT_DIR___DVD '$OUTPUT_DIR___DVD' (see CONF_FILE '$CONF_FILE') NOT FOUND!"
    DVD_OUTPUT_FN="$OUTPUT_DIR___DVD/$DVD_OUTPUT_FN"

    # by default (with no other titles filtering parameter set) list ALL titles:
    [ -z "$DVD_MAIN_TITLE$DVD_TITLE_MINDUR$DVD_TITLE_MAXDUR$DVD_TITLES$DVD_TITLES_INCLUDE$DVD_TITLES_EXCLUDE" ] && DVD_ALL_TITLES=1 && vrb "Defaulting to '--all' to list ALL available titles.";

    # count all DVD_NUMS:
    [ -z "$DVD_NUMS" ] && TOTAL_INPUT_CNT=1 || {
      TOTAL_INPUT_CNT=0; for i in $DVD_NUMS; do TOTAL_INPUT_CNT=$(( $TOTAL_INPUT_CNT + 1 )); done
    };;

  FILE)
    get_output_suffix "$ENCODE_CMDSTR_NAME"; dbg "DBG: Set OUTPUT_SUFFIX='$OUTPUT_SUFFIX'"
    [ -z "$OUTPUT_DIR___FILE" -o -d "$OUTPUT_DIR___FILE" ] || err 035 "OUTPUT_DIR___FILE '$OUTPUT_DIR___FILE' (see CONF_FILE '$CONF_FILE') NOT FOUND!"
    if [ -z "$FILE_OUTPUT_FN" ]; then
      if [ -z "$OUTPUT_DIR___FILE" ]; then
        OUTPUT_PATH___FILE="\$INPUT_PATH_BASE\$FILE_OUTPUT_FN_TAG.\$OUTPUT_SUFFIX"
        dbg "DBG: Setting OUTPUT_PATH___FILE using PATH from MOVIEFILE '$INPUT_PATH_BASE': '$OUTPUT_PATH___FILE'";
      else
        OUTPUT_PATH___FILE="$OUTPUT_DIR___FILE/\$INPUT_FN_BASE\$FILE_OUTPUT_FN_TAG.\$OUTPUT_SUFFIX"
        dbg "DBG: Setting OUTPUT_PATH___FILE using PATH from CONF_FILE '$OUTPUT_DIR___FILE': '$OUTPUT_PATH___FILE'";
      fi
    else
      if [ -z "$OUTPUT_DIR___FILE" ]; then
        OUTPUT_PATH___FILE="$FILE_OUTPUT_FN"
        dbg "DBG: Setting OUTPUT_PATH___FILE using only FILE_OUTPUT_FN: '$OUTPUT_PATH___FILE'";
      else
        OUTPUT_PATH___FILE="$OUTPUT_DIR___FILE/${FILE_OUTPUT_FN##*/}" # ensure that we don't have any PATH in $FILE_OUTPUT_FN
        dbg "DBG: Setting OUTPUT_PATH___FILE using FILE_OUTPUT_FN (omitting any PATH in there) and using OUTPUT_DIR___FILE from CONF_FILE '$OUTPUT_DIR___FILE': '$OUTPUT_PATH___FILE'";
      fi
    fi
    [ -z "$OUTPUT_PATH___FILE" ] && err 037 "Missing OUTPUT_PATH___FILE. Not sure why...";
    ;;

esac

####################################################################
# OUTPUT VARIABLES:
[ -z "$DO_CLEANUP" ] && tmp=" and will *NOT* CLEANUP" || tmp=" and will CLEANUP"
vrb ">>> MODE='$MODE' CMD='$CMD' --> EVAL_STR='$EVAL_STR'$tmp"
[ $VRB ] && case "$MODE" in
   FILE) vrb ">>> Found $TOTAL_INPUT_CNT FILEs." vrb ">>> #OPTIONAL-PARAMS#:";
         set|env LC_ALL=C gawk -b '/^FILE_/{sub(/^/,"    "); print $0}';;
   DVD)  vrb ">>> Found $TOTAL_INPUT_CNT DVDs."; vrb ">>> #OPTIONAL-PARAMS#:";
         set|env LC_ALL=C gawk -b '/^DVD_/{sub(/^/,"    "); print $0}';;
esac
[ $VRB ] && case "$CMD" in
   ENCODE) vrb ">>> CMD_PARAMS of <CMD> '$CMD': (only ENCODE_CMDSTR_NAME is /mandatory)";
           set|env LC_ALL=C gawk -b '/^ENCODE_/{sub(/^/,"    "); print $0}';;
esac

####################################################################
# DO IT:

case "$MODE" in
  FILE) # HERE we KNOW that TOTAL_INPUT_CNT > 0 !
    FILE_NR=0;
    while [ $FILE_NR -lt $TOTAL_INPUT_CNT ]; do
      FILE_NR=$(( $FILE_NR + 1 )); INPUT_IDX="$FILE_NR"

      INPUT_PATH="$(echo "$VIDEOFILES"|sed -n "${FILE_NR}p")" || err 036 # we use this INSTEAD of <<_eof_ as this stdin based appproach breaks when HandBrakeCli is called!
      [ -z "$INPUT_PATH" ] && err 033 "FILE_NR='$FILE_NR', TOTAL_INPUT_CNT='$TOTAL_INPUT_CNT'"

      # prepare '$CTP' with TITLE SPECIFIC string for this title_nr ! (see --ctp<title_nr>)
      eval "CTP=\"\$CTP$FILE_NR\"" && dbg "~~~ [FILE LOOP] Using \$CTP '$CTP' (from CTP$FILE_NR).";

      # determine OUTPUT_PATH
      INPUT_FN="${INPUT_PATH##*/}";         # only FILENAME of INPUT_PATH
      INPUT_FN_DIR="${INPUT_PATH%/*}";      # only PATH of INPUT_PATH
      INPUT_FN_BASE="${INPUT_FN%.*}";       # INPUT_FN without LAST suffix
      INPUT_PATH_BASE="${INPUT_PATH%.*}";   # INPUT_PATH without LAST suffix
      # At this point we directly set OUTPUT_PATH (needed by get_titles, called by get_encode):
      dbg "~~~ [FILE LOOP] eval \"OUTPUT_PATH='$OUTPUT_PATH___FILE'\""
      eval "OUTPUT_PATH=\"$OUTPUT_PATH___FILE\"";

      # ensure that OUTPUT_PATH ends with $OUTPUT_SUFFIX:
      OUTPUT_PATH="$(echo "$OUTPUT_PATH"|env LC_ALL=C gawk -v SFX="$OUTPUT_SUFFIX" -b '{if (match($0,"[.]"SFX"$")){print $0}else{print $0"."SFX}}')"

      dbg "~~~ [FILE LOOP] INPUT_PATH='$INPUT_PATH'"
      dbg "~~~ [FILE LOOP] -> INPUT_FN='$INPUT_FN', INPUT_FN_BASE='$INPUT_FN_BASE'"
      dbg "~~~ [FILE LOOP] -> OUTPUT_PATH='$OUTPUT_PATH'"

      if [ $DBG ]; then dbg; dbg "~~~ [FILE LOOP]: FILE $FILE_NR (FILE_NR) / $TOTAL_INPUT_CNT (TOTAL_INPUT_CNT)";
                   else vrb; vrb ">>> FILE $FILE_NR/$TOTAL_INPUT_CNT"; fi;
      eval "$EVAL_STR"
      rc=$?;
      rcs="$rcs $rc";
      dbg "~~~ [FILE LOOP] RETURN CODE = $rc."
    done
    # count errors:
    i=0; for rc in $rcs; do [ $rc -ne 0 ] && i=$(( $i + 1 )); done
    if [ $i -eq 0 ]; then vrb; vrb "Done - successfully."; vrb; exit 0;
                     else echo; echo "$i / $TOTAL_INPUT_CNT FILES had ERRORS !"; echo; exit 1; fi;
    ;;
  DVD)
    if [ -z "$DVD_NUMS" ]; then 
      INPUT_IDX=1; DVD_NR=_;
      INPUT_PATH="$DVD_DIR"; dbg "~~~ [SINGLE DVD] INPUT_PATH='$INPUT_PATH'"
      eval "$EVAL_STR"; rc=$?;
      if [ $rc -eq 0 ]; then 
        echo "${NL}  > [SINGLE DVD] SUCCESSFUL :)  (RETURN CODE = $rc)"
        do_eject exit "(if successful) as asked";
     else
        echo "${NL}  > [SINGLE DVD] FAILED !!! - RETURN CODE = $rc."; echo; exit $rc;
     fi
    else
      INPUT_IDX=0; rcs=;
      DVD_DIR_ORIG="$DVD_DIR"
      for DVD_NR in $DVD_NUMS; do
        INPUT_IDX=$(( $INPUT_IDX + 1 ))
        DVD_NR_2=$(format_as_2_digits "$DVD_NR");
        eval "DVD_DIR=\"$DVD_DIR_ORIG\""; INPUT_PATH="$DVD_DIR";
        if [ $DBG ]; then dbg; dbg "~~~ [DVD LOOP] DVD $INPUT_IDX/$TOTAL_INPUT_CNT (#$DVD_NR_2): DVD_NR='$DVD_NR' / DVD_NR_2='$DVD_NR_2' -> DVD_DIR='$DVD_DIR'";
                     else vrb; vrb ">>> DVD $INPUT_IDX/$TOTAL_INPUT_CNT (#$DVD_NR_2): DVD_DIR='$DVD_DIR'"; fi

        eval "$EVAL_STR"; rc="$?"; rcs="$rcs $rc";
        if [ $rc -eq 0 ]; then
          echo "${NL}  > [DVD LOOP] DVD $INPUT_IDX/$TOTAL_INPUT_CNT (#$DVD_NR_2): SUCCESSFUL :)  (RETURN CODE = $rc. [rcs='$rcs'])"
          do_eject "" "(if successful) as asked";
        else
          echo "${NL}  > [DVD LOOP] DVD $INPUT_IDX/$TOTAL_INPUT_CNT (#$DVD_NR_2): FAILED !!! - RETURN CODE = $rc. [rcs='$rcs']"
        fi
      done
      # count errors:
      i=0; for rc in $rcs; do [ $rc -ne 0 ] && i=$(( $i + 1 )); done
      if [ $i -eq 0 ]; then echo; echo "All done - successfully."; exit 0;
                       else echo; echo "$i / $TOTAL_INPUT_CNT DVDS had ERRORS !"; exit 1; fi;
    fi;;
esac

