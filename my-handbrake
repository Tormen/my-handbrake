#!/bin/sh

# 075 == highest used errCode

. "/LINKS/default/my-cmdstrs" || { echo "FAILED [$?] TO ACCESS CMDSTRFILE. EXITING."; exit 1; }

CONF_FILE_GLOBAL="/LINKS/default/my-handbrake.GLOBAL"
## both spellings are accepted under /LINKS/default: .conf first, then bare
CONF_FILE_LOCAL="/LINKS/default/my-handbrake.conf"
[ -e "$CONF_FILE_LOCAL" ] || CONF_FILE_LOCAL="/LINKS/default/my-handbrake"
[ -s "$CONF_FILE_GLOBAL" ] && . "$CONF_FILE_GLOBAL"
[ -s "$CONF_FILE_LOCAL" ] && . "$CONF_FILE_LOCAL"

DBG="" # can be set via --debug|-D parameter !
VRB="" # can be set via --verbose|-V parameter !
DO_CLEANUP="1" # can be UNSET via --leave|-L parameter !
DO_EJECT="" # can be set via --eject|-E parameter!
DO_GAP_ANALYSIS=1; # can be unset with --no-gap-analysis parameter!

PWD="$(pwd)" || err 020

NL="
"

######################################################################


usage() {
  echo "usage: $0 [GLOBAL-PARAMETERS] <MODE> ... <CMD> ...

This script uses 1st CONF_FILE_GLOBAL = '$CONF_FILE_GLOBAL' - if available.
This script uses 2nd CONF_FILE_LOCAL = '$CONF_FILE_LOCAL' - if available - allowing to overwrite GLOBAL defaults.
Below we refer to CONF_FILE as either of them.

______________________________________________________________________________________________________
[GLOBAL-PARAMETERS]
  --help        Show this text
  -d|--dry      Only PRINT what /woud/ be done
  -D|--debug    To turn on DEBUG mode
  -V|--verbose  To turn on VERBOSE output
  -L|--leave    Do NOT cleanup. This may leave behind (e.g. when encoding gets interrupted):
                  * video file(s) - suffixed with '.UNFINISHED'
                  * logfiles (with HandBrakeCLI output) - suffixed with '.log'

______________________________________________________________________________________________________
<MODE> can be: file/FILE | dvd/DVD

* file     <VIDEOFILE> [VIDEOFILE [..]] [OPTIONAL-PARAMS] -- <CMD> [CMD_PARAM_1 [CMD_PARAM_2] [..]]
  Supported [OPTIONAL-PARAMS]   --sub, --audio
  Supported <CMD>               encode, scan
  Supported [CMD_PARAMs]        --tag, --ctp, --output-fn

  #OPTIONAL-PARAMS#
    ### ABOUT SUBTITLE SELECTION ###
    Without any of the following parameters, \$FILE_SUB defaults to *ALL* available subtitles (of each title) will be selected!
    --sub <comma-separated-list-of-subtitle-tracks>  -- see the output of --scan, e.g. --sub 1,2 or --sub 2
      Sets the subtitles to select (if available) for EACH title (and each FILE).
      The value of this parameter will be available as \$FILE_SUB. Useful e.g. within the MY_CMDSTR_NAME!

    ### ABOUT AUDIO SELECTION ###
    Without any of the following parameters, \$FILE_AUDIO defaults to *ALL* available audio tracks (of each title) will be selected!
    --audio <comma-separated-list-of-subtitle-tracks>  -- see the output of '-- scan', e.g. --sub 1,2 or --sub 2
      Sets the audio tracks to select (if available) for EACH title (and each FILE).
      The value of this parameter will be available as \$FILE_AUDIO. Useful e.g. within the MY_CMDSTR_NAME!

  #OPTIONAL-PARAMS#

    ### ABOUT OUTPUT-FILENAME + EPISODE/SEASON NUMBERING ###
    --output-fn <FILE_OUTPUT_FN>
      If parameter is omitted, then:
          > IF \$OUTPUT_DIR___FILE (from CONF_FILE) is NOT set (\$OUTPUT_DIR___FILE=\"\"):
               \$INPUT_PATH_BASE + [ \$FILE_OUTPUT_FN_TAG ] \".\" + \$OUTPUT_SUFFIX
          > ELSE (\$OUTPUT_DIR___FILE (from CONF_FILE) is set):
               \$OUTPUT_DIR___FILE + \"/\" + <VIDEOFILE without PATH and without suffix> + [ \$FILE_OUTPUT_FN_TAG ] \".\" + \$OUTPUT_SUFFIX
      Else:
          > IF \$OUTPUT_DIR___FILE (from CONF_FILE) is NOT set (\$OUTPUT_DIR___FILE=\"\"):
               \$FILE_OUTPUT_FN (but making sure that it ends with \$OUTPUT_SUFFIX!)
          > ELSE (\$OUTPUT_DIR___FILE (from CONF_FILE) is set):
               \$OUTPUT_DIR___FILE/\${FILE_OUTPUT_FN##*/} (only FILENAME from FILE_OUTPUT_FN, making sure that it ends with \$OUTPUT_SUFFIX!)
      will be used - note: There is NO space around the \$FILE_OUTPUT_FN_TAG.
      So in any case this variable will be set (and made available as variable '\$FILE_OUTPUT_FN')!
      and in any case we will ensure that it ends with \$OUTPUT_SUFFIX!
      This string might contain the variables '\$OUTPUT_DIR___FILE' (see CONF_FILE!)
                                              '\$CTP' (see --ctp<file_nr>)
                                              '\$FILE_NR' / '\$INPUT_IDX' (both same value: number of file-parameter on command-line)
                                              '\$INPUT_PATH'      (VIDEOFILE #\$FILE_NR as provided on commandline)
                                              '\$INPUT_PATH_BASE' (INPUT_PATH without SUFFIX (so without the part behind last \. in VIDEOFILE parameter)
                                              '\$INPUT_FN'        (only FILENAME part of VIDEOFILE)
                                              '\$INPUT_FN_DIR'    (only DIRECTORY part of VIDEOFILE)
                                              '\$INPUT_FN_BASE'   (INPUT_FN   without SUFFIX (so without the part behind last \. in \$INPUT_FN))
                                              '\$OUTPUT_SUFFIX'   (get_output_suffix \$ENCODE_CMDSTR_NAME -- filesuffix of result of ENCODE_CMDSTR)
      But in order to use variables you need to use SINGLE-QUOTES or you need to escape the '$'!

  Further details about <CMD> and [CMD_PARAMs] NOT explained above: See below with MODE dvd.

* dvd      <DVD_DIR> [OPTIONAL-PARAMS] <CMD> [CMD_PARAM_1 [CMD_PARAM_2] [..]]
  <DVD_DIR>   -- Is the path to the VIDEO_TS/AUDIO_TS directories!
                 Also see --dvds param below.
                 Can contain the VARIABLE-PLACEHOLDER '\$DVD_NR' which will be replaced with dvd-number (as produced by --dvds parameter)
                 Can contain the VARIABLE-PLACEHOLDER '\$DVD_NR_2' which will be replaced with dvd-number formated with 2 digits

  #OPTIONAL-PARAMS#

    ### ABOUT DVD_DIR ###
    --dvds <FIRST> <LAST>   -- Parameter can be used multiple times!
                               All DVD numbers will be collected as space separated list in variable \$DVD_NUMS.
                               Each parameter will add sequence <FIRST> to <LAST> (result of call to \"seq -s ' ' <FIRST> <LAST>\") to \$DVD_NUMS.
                               Any --dvds parameter will cause a loop over all \$DVD_NUMS replacing \$DVD_NR/\$DVD_NR_2 in \$DVD_DIR
                               before doing the provided <CMD>.
                               So, the current DVD number will be available as variable \$DVD_NR and \$DVD_NR_2.
                               To select a single DVD you need to provide the SAME <FIRST> and <LAST> !

    ### ABOUT TITLE SELECTION ###
    # independent of DVD_NR:
    --no-gap-analysis == do NOT check for a gap of 1 title nr and identical titles BEFORE and AFTER the gap
                         By default we will DO_GAP_ANALYSIS, as VIDEO DVDs from at least Panasonic TV DVD Recorder
                         contain all titles 2x with gap of 1 title ! (e.g. Titles 1-10 and 11-21 where 11-21 are identical to 1-10)
    --all      == consider ALL titles
    --main     == consider only the \"Main Feature\"
    --mindur   == minimum duration (>) in the format \"hours{2}:minutes{2}\", e.g. 00:49 (of titles to consider)
    --maxdur   == maximum duration (<) in the format \"hours{2}:minutes{2}\", e.g. 00:49 (of titles to consider)
    --titles X == This definitely selects titles and will IGNORE --mindur && --maxdur!
                  X = STRING as space/or/comma-separated list of title numbers (to consider as well). RANGES 1-3 are also possible! 

    # dependent of DVD_NR:
    --include == 1 STRING as space/or/comma-separated list of : separated pairs \"<DVD_NR>:<title-to-ignore>\"
    --exclude == 1 STRING as space/or/comma-separated list of : separated pairs \"<DVD_NR>:<title-to-ignore>\"
              --exclude SUPERSEEDS --include !

    ### ABOUT OUTPUT-FILENAME + EPISODE/SEASON NUMBERING ###
    --ctp<title_nr> <custom-target-part-string that will be assigned to \$CTP for title <title_nr>>
      To have title dependend custom string in variable \$CTP for usage in --output-fn
      EXAMPLE: --ctp1 <xx> --ctp02 <yy>    ===>    set \$CTP to <xx> for title 1    &&    set \$CTP to <yy> for title 2
    --tag       <DVD_OUTPUT_FN_TAG>  -- only used if --output-fn is OMITTED ! See --output-fn !
    --output-fn <DVD_OUTPUT_FN>
      If parameter is omitted, then:
          \$OUTPUT_DIR___DVD(from CONF_FILE) + \"/\" + <last part (directory) of DVD_DIR> + \"_\" + [ \$DVD_EPISODE_STR ] + [ \$DVD_OUTPUT_FN_TAG ] + \".\" + \$OUTPUT_SUFFIX
      will be used - note: There is NO space around the \$DVD_OUTPUT_FN_TAG.
      So in any case this variable will be set (and made available as variable '\$DVD_OUTPUT_FN')
      and in any case we will ensure that it ends with \$OUTPUT_SUFFIX!
      This string might contain the variables '\$OUTPUT_DIR___DVD' (see CONF_FILE!)
                                              '\$DVD_SEASON', '\$DVD_EPISODE', '\$DVD_EPISODE_STR' (see --episode)
                                              '\$DVD_NR', '\$DVD_NR_2' (see <DVD_DIR>)
                                              '\$CTP' (see --ctp<title_nr>)
                                              '\$TITLE_NR', '\$TITLE_NR_2DIGIT' (current title Nr, or title-nr-formated-as-2-digit-nr)
                                              '\$TITLE_COUNT', '\$TITLE_COUNT_2DIGIT' (count index of this title Nr, or title-nr-formated-as-2-digit-nr)
                                              '\$OUTPUT_SUFFIX'   (get_output_suffix \$ENCODE_CMDSTR_NAME -- filesuffix of result of ENCODE_CMDSTR)
      But in order to use variables you need to use SINGLE-QUOTES or you need to escape the '$'!
    --episode <SEASON_NR> <EPISODE_NR>
      This parameter decides how the OUTPUT-FILENAME (\$output) will be differenciated for *each title*
      using the variable \$DVD_EPISODE_STR:
         * If omitted and multiple --titles, then \$DVD_EPISODE_STR=\"DVD_#<DVD_NR>_TITLE_#<TITLE>\".
         * If omitted and single --title, then \$DVD_EPISODE_STR=\"\".
         * Otherwise: The provided --episode will be used in the FIRST filename as \$DVD_EPISODE_STR=\"S<SEASON_NR>E<EPISODE_NR>\",
                      then <EPISODE_NR> increases after each title!

    ### ABOUT SUBTITLE SELECTION ###
    Without any of the following parameters, \$DVD_SUB defaults to *ALL* available subtitles (of each title) will be selected!
    --sub <comma-separated-list-of-subtitle-tracks>  -- see the output of --scan, e.g. --sub 1,2 or --sub 2
      Sets the subtitles to select (if available) for EACH title (and each DVD).
      The value of this parameter will be available as \$DVD_SUB. Useful e.g. within the MY_CMDSTR_NAME!

    ### ABOUT AUDIO SELECTION ###
    Without any of the following parameters, \$DVD_AUDIO defaults to *ALL* available audio tracks (of each title) will be selected!
    --audio <comma-separated-list-of-subtitle-tracks>  -- see the output of '-- scan', e.g. --sub 1,2 or --sub 2
      Sets the audio tracks to select (if available) for EACH title (and each DVD).
      The value of this parameter will be available as \$DVD_AUDIO. Useful e.g. within the MY_CMDSTR_NAME!

  <CMD> [CMD_PARAM_1 [..]] can be:  ### HERE:NEW-CMD_PARAMS !!!

     custom        DVD MODE:  run DVD_custom  from CONF_FILE (with the variables MODE, DVD_DIR, CMD and the CMD_PARAMS (<CMD>_SOMETHING...) set)
                   FILE MODE: run FILE_custom from CONF_FILE (with the variables MODE, CMD and the CMD_PARAMS (<CMD>_SOMETHING...) set)

     scan          print raw output of $SCAN_CMD <DVD-DIR>

     titles        print titles (one title per line):
                     <input_nr(DVD_NR or FILE_NR)> <title_count> <title_nr> <duration(HH:MM)> <audio(comma-separated-list-of-tracks)> <subtitles(comma-separated-list-of-tracks)> <output_fn>
                   Uses all parameters explained in the section '### ABOUT TITLE SELECTION ###'.
                   ALL entries except <input_nr> and <subtitles> are mandatory:
                     <input_nr>  = _ in case no --dvds parameter was provided
                     <subtitles> = _ in case no subtitles where found
                   DEPENDENCIES:
                     <input_nr>    will depend on --dvds parameter [for MODE:DVD], [for MODE:FILE] will be nr of current FILE
                     <title_count> will depend on selected titles (see: ### ABOUT TITLE SELECTION ###)
                     <title_nr>    will depend on selected titles (see: ### ABOUT TITLE SELECTION ###)
                     <duration>    will depend on selected titles (see: ### ABOUT TITLE SELECTION ###, especially --mindur, --maxdur)
                     <audio>       will depend on selected titles and parameter --audio
                     <subtitles>   will depend on selected titles and parameter --sub
                     <output_fn>   will depend on selected titles and parameter --episode   --tag   --ctp<title_nr>    --output-fn

     encode [MY_CMDSTR_NAME] [--force-overwrite]
            [MY_CMDSTR_NAME]
                   Defaults to '$MY_DEFAULT_PRESET' (see \$MY_DEFAULT_PRESET in CONF_FILE).
                   Available MY_CMDSTR_NAME values are:
$(cat "$CONF_FILE_GLOBAL" "$CONF_FILE_LOCAL"|env LC_ALL=C gawk -b -F '=' '{gsub(/[[:space:]]/, ""); $0=$0; if (/^MY_PRESET_/){print $1}}'|sort|uniq|sed -n 's/^MY_PRESET_/                      /p')
                   \"MY_PRESET_<MY_CMDSTR_NAME>\" will be the *name* of the variable containting the CMDSTR to use when calling HandBrake!
                   This variable needs to be defined in CONF_FILE.
                   You can use the following VARIABLES within the CMDSTR:
                      * '\$input' ------ the input file/dir ======================= eval of '\$DVD_DIR' [for MODE:DVD], FILE_NAME [for MODE:FILE]
                      * '\$title' ------ the title ================================ each of the selected TITLES
                      * '\$output' ----- the output file ========================== eval of the selected TITLES (see output of 'titles' <CMD>)
                      * '\$subtitles' -- the subtiles (comma-separated list) ====== eval of the selected TITLES (see output of 'titles' <CMD>)
                      * '\$audio' ------ the audio tracks (comma-separated list) == eval of the selected TITLES (see output of 'titles' <CMD>)
            [-f|--force-overwrite]
                   If omitted, then an already existing output file will be SKIPPED!
                   If provided, then an already existing output file will be overwritten and RE-ENCODED!
            [-o|--only <GREP-PATTERN>]
                   If provided, then only TITLES whose OUTPUT_FN match (grep -i, so case-insensitive) this GREP-PATTERN will be encoded.
            [-q|--quality <QUALITY-NR>]
                   If provided, this overwrites the default quality \$MY_DEFAULT_QUALITY from CONF_FILE '$MY_DEFAULT_QUALITY'.
                   Lower value = better quality, but bigger files. Increase/Decrease by 1 or max 2.
                   Less than 20 should (probably) never be necessary.


______________________________________________________________________________________________________
EXAMPLES:

  //// OF *ONE* (specific) DVD ////

  * Scan complete DVD (listing all available titles, subtitles, audiotracks, ...):
    my-handbrake dvd '/run/media/me/everything-mobil/der-doktor-und-das-liebe-vieh/21/Der Doktor Und Das Liebe Vieh' scan

  * List all titles (using all available subtitles and all audio tracks for each title):
    my-handbrake dvd '/run/media/me/everything-mobil/der-doktor-und-das-liebe-vieh/21/Der Doktor Und Das Liebe Vieh' --mindur 00:40 --maxdur 00:59 --main --titles '10 20 21' titles

  //// OF *ALL* DVDs #2 .. #26 ////

  * List all titles between 40 and 59min long excluding dvd-10_title-6 and dvd-10_title-7:
    my-handbrake dvd '/mnt/everything/der-doktor-und-das-liebe-vieh/\$DVD_NR_2/Der Doktor Und Das Liebe Vieh' --dvds 2 26 --episode 1 4 --mindur 00:40 --maxdur 00:59 --exclude '10:6 10:7' titles

  * Encode all titles between 40 and 59 min long using all available subtitles and audio-tracks for all DVDs #1 .. #26:

    > and skip already existing output files <
    my-handbrake dvd '/run/media/me/everything-mobil/der-doktor-und-das-liebe-vieh/\$DVD_NR/Der Doktor Und Das Liebe Vieh' --dvds 01 26 --mindur 00:40 --maxdur 00:59' encode --episode 1 1 --output-fn 'Der Doktor Und Das Liebe Vieh \${DVD_EPISODE_STR}.mkv'

    > and FORCE overwriting and re-encoding already existing output files <
    my-handbrake dvd '/run/media/me/everything-mobil/der-doktor-und-das-liebe-vieh/\$DVD_NR/Der Doktor Und Das Liebe Vieh' --dvds 01 26 --mindur 00:40 --maxdur 00:59' encode --episode 1 1 --output-fn 'Der Doktor Und Das Liebe Vieh \${DVD_EPISODE_STR}.mkv' --force-overwrite

   //// ENCODE TV DVD recordings:

   * WWM - Wer wird Millionaer:
   yy=2008; nr=741; mi='[MI-015]'; w=/Volumes/SONATA\\ 3; my-handbrake dvd \"\$w\" --titles 1,2,3 --ctp1 \"\$yy-05-09 \$mi [Folge \$nr]\" --ctp2 \"\$yy-05-16 \$mi [Folge \$(( \$nr + 1 ))]\" --ctp3 \"\$yy-05-23 \$mi [Folge \$(( \$nr + 3 ))]\" --ctp4 \"\$yy-05-26 \$mi [Folge \$(( \$nr + 4 ))]\" --output-fn \'\$CTP WWM - Wer wird Millionaer' encode tvDVD --eject

   * Millionenshow:
   yy=2014; S=\"S14E\"; E=11; nr=760; mi=\"[MI-156]\"; w=/Volumes/DVD_VIDEO_RECORDER\ 2; my-handbrake dvd \"\$w\" --titles 2,3,4 --ctp2 \"\$yy-01-13 \$mi [Folge \$(( \$nr + 0 ))] \$S\$(printf %02d \$(( \$E + 0 )))\" --ctp3 \"\$yy-01-20 \$mi [Folge \$(( \$nr + 1 ))] \$S\$(printf %02d \$(( \$E + 1 )))\" --ctp99 \"\$yy-12-09 \$mi [Folge \$(( \$nr + 2 ))] \$S\$(printf %02d \$(( \$E + 2 )))\" --ctp5 \"\$yy-11-11 \$mi [Folge \$(( \$nr + 3 ))] \$S\$(printf %02d \$(( \$E + 3 )))\" --ctp6 \"\$yy-11-18 \$mi [Folge \$(( \$nr + 4 ))] \$S\$(printf %02d \$(( \$E + 4 )))\" --ctp4 \"\$yy-02-10 \$mi [Promi-Millionenshow 33] [Spezial]\" --output-fn 'Millionenshow \$CTP' --ctp98 \"\$yy-02-10 \$mi [Faschings-Millionenshow \$yy] [Spezial]\" --ctp99 \"\$yy-02-10 \$mi [Die Weihnachts-Millionenshow \$yy] [Spezial]\" encode tvDVD --eject

   * Make use of DO_GAP_ANALYSIS:
   w=/Volumes/DVD_VIDEO_RECORDER; env mi=\"S-11\" my-handbrake dvd \"\$w\" --all --mindur 00:01 --output-fn 'Schlager \$mi title \$TITLE_COUNT_2DIGIT' encode veryFastAudioPassthrough --eject

   //// FILES:
   * see media information (audio tracks, subtitle tracks):
   my-handbrake file mediaFile.mkv -- scan

   * rip all audio + subs:
   my-handbrake file mediaFile.something.mkv -- encode reencode --output-fn \"mediafile.mkv\"

   * rip only audio track 2:
   my-handbrake file mediaFile.something.mkv --audio 2 -- encode reencode --output-fn \"mediafile.mkv\"
"|less

exit 0
}


dbg() { if [ $DBG ]; then if [ $# -eq 0 ]; then echo 1>&2; else local x_=; for x_ in "$@"; do echo "$x_" 1>&2; done; fi; fi; [ 0 -eq 0 ]; }
vrb() { if [ $VRB ]; then if [ $# -eq 0 ]; then echo; else local x_=; for x_ in "$@"; do echo "$x_"; done; fi; fi; [ 0 -eq 0 ]; }


err() { local errCode="$1"; [ -z "$2" ] && local msg="Please fix." || local msg="$2"; [ -z "$3" ] && local exitCode=1 || local exitCode="$3";
    echo "${NL}ERROR $errCode [$exitCode]: $msg" 1>&2;
    exit $exitCode;
}


strip_opt_leading_zero() { [ -n "$1" ] && echo "$1"|sed -e 's/^0*//'; }
format_as_2_digits() { if [ -n "$1" ]; then echo "$1"|env LC_ALL=C gawk -b "{if (/^[0-9]*$/){printf(\"%02d\",\"$1\")}else{printf(\"%s\",\"$1\")}}"; fi; }

